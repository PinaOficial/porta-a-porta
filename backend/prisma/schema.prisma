  joined_at      DateTime  @default(now()) @db.Timestamptz(6)
  ultimo_lido_em DateTime? @db.Timestamptz(6)
  conversa       conversa  @relation(fields: [id_conversa], references: [id_conversa], onDelete: Cascade, onUpdate: NoAction)
  usuario        usuario   @relation(fields: [id_usuario], references: [id_usuario], onUpdate: NoAction)

  @@id([id_conversa, id_usuario])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
