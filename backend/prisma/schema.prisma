}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model pedido_status_historico {
  id_historico    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_pedido       String              @db.Uuid
  status_anterior status_pedido_enum?
  status_novo     status_pedido_enum
  alterado_por    String              @db.Uuid
  motivo          String?             @db.VarChar(255)
  created_at      DateTime            @default(now()) @db.Timestamptz(6)
  usuario         usuario             @relation(fields: [alterado_por], references: [id_usuario], onUpdate: NoAction)
  pedido          pedido              @relation(fields: [id_pedido], references: [id_pedido], onUpdate: NoAction)

  @@index([id_pedido, created_at], map: "historico_pedido_data_idx")
}

