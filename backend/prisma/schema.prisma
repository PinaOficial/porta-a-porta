  status_conversa       status_conversa_enum    @default(ATIVA)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  encerrada_em          DateTime?               @db.Timestamptz(6)
  pedido                pedido                  @relation(fields: [id_pedido], references: [id_pedido], onUpdate: NoAction)
