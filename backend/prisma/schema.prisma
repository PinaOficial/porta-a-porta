generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model auditoria {
  id_auditoria  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_ator       String      @db.Uuid
  acao          String      @db.VarChar(100)
  entidade      String      @db.VarChar(80)
  entidade_id   String      @db.Uuid
  id_condominio String?     @db.Uuid
  metadata      Json?
  created_at    DateTime    @default(now()) @db.Timestamptz(6)
  usuario       usuario     @relation(fields: [id_ator], references: [id_usuario], onUpdate: NoAction)
  condominio    condominio? @relation(fields: [id_condominio], references: [id_condominio], onUpdate: NoAction)

  @@index([id_ator, created_at], map: "auditoria_ator_data_idx")
  @@index([id_condominio, created_at], map: "auditoria_condominio_data_idx")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model categoria_produto {
  id_categoria String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome         String    @unique @db.VarChar(80)
  ativo        Boolean   @default(true)
  produto      produto[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
