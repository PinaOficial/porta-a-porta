/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model vinculo_condominio {
  id_vinculo                                               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_condomino                                             String              @unique(map: "one_active_membership_per_user", where: raw("(status_vinculo = 'ATIVO'::status_vinculo_enum)")) @db.Uuid
  id_condominio                                            String              @db.Uuid
  moradia                                                  String              @db.VarChar(80)
  admin_condominio                                         Boolean             @default(false)
  status_vinculo                                           status_vinculo_enum @default(PENDENTE)
  data_solicitacao                                         DateTime            @default(now()) @db.Timestamptz(6)
  data_aprovacao                                           DateTime?           @db.Timestamptz(6)
  data_inicio                                              DateTime?           @db.Timestamptz(6)
  data_fim                                                 DateTime?           @db.Timestamptz(6)
  aprovado_por                                             String?             @db.Uuid
  admin_atualizado_por                                     String?             @db.Uuid
  admin_atualizado_em                                      DateTime?           @db.Timestamptz(6)
  pedido                                                   pedido[]
  produto                                                  produto[]
  usuario_vinculo_condominio_admin_atualizado_porTousuario usuario?            @relation("vinculo_condominio_admin_atualizado_porTousuario", fields: [admin_atualizado_por], references: [id_usuario], onUpdate: NoAction)
  usuario_vinculo_condominio_aprovado_porTousuario         usuario?            @relation("vinculo_condominio_aprovado_porTousuario", fields: [aprovado_por], references: [id_usuario], onUpdate: NoAction)
  condominio                                               condominio          @relation(fields: [id_condominio], references: [id_condominio], onUpdate: NoAction)
  condomino                                                condomino           @relation(fields: [id_condomino], references: [id_condomino], onUpdate: NoAction)

  @@index([id_condominio, status_vinculo], map: "vinculo_condominio_status_idx")
