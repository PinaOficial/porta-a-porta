PORT=3000
CORS_ORIGIN=http://localhost:5173

# Supabase
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_SUBSTITUA_AQUI

# Use o Supavisor Session pooler (porta 5432).
# Copie a URI no botão Connect do Supabase e troque o usuário postgres pelo usuário prisma.
# Exemplo:
# postgresql://prisma.SEU_PROJECT_REF:SENHA_PRISMA@HOST_DO_POOLER:5432/postgres
DATABASE_URL=postgresql://prisma.SEU_PROJECT_REF:SENHA_PRISMA@HOST_DO_POOLER:5432/postgres
